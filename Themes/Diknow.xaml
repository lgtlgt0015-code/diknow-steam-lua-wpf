<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="DiknowPanel">#211E29</Color>
    <Color x:Key="DiknowBase">#17151D</Color>
    <Color x:Key="DiknowAccent">#CCB4EF</Color>
    <Color x:Key="DiknowText">#F4F0F8</Color>
    <Color x:Key="DiknowMuted">#C2BACA</Color>
    <Color x:Key="DiknowLine">#514858</Color>
    <Color x:Key="DiknowCard">#FF3D3747</Color>
    <Color x:Key="ControlFillColorDefault">#FF413A4B</Color>
    <Color x:Key="CardBackgroundFillColorDefault">#FF3D3747</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="{StaticResource DiknowAccent}"/>
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{StaticResource DiknowAccent}"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource DiknowText}"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource DiknowMuted}"/>
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="{StaticResource DiknowLine}"/>
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource DiknowLine}"/>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource DiknowCard}"/>
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource DiknowBase}"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource DiknowPanel}"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="{StaticResource DiknowPanel}"/>
</ResourceDictionary>
